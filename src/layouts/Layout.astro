---
import "@/styles/globals.css";
import { explorations } from "@/data/explorations";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <!-- <link
			rel="preload"
			href={whoisFont}
			as="font"
			type="font/ttf"
			crossorigin="anonymous"
		/> -->
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://tochi.dev" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content="Tochukwu Nweke" />
        <meta property="og:image" content="/og.png" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content="https://tochi.dev" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content="Tochukwu Nweke" />
        <meta property="twitter:image" content="/og.png" />
    </head>
    <body>
        <button
            class="menu-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="exploration-drawer"
            aria-label="Open explorations menu"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="menu-backdrop" data-menu-backdrop></div>
        <aside
            id="exploration-drawer"
            class="exploration-drawer"
            aria-label="Explorations"
            aria-hidden="true"
        >
            <div class="drawer-header">
                <div>
                    <p class="drawer-eyebrow">Animation lab</p>
                    <h2>Explorations</h2>
                </div>
                <button
                    class="drawer-close"
                    type="button"
                    aria-label="Close explorations menu"
                >
                    <span></span>
                    <span></span>
                </button>
            </div>

            <nav aria-label="Exploration pages">
                <ul>
                    {explorations.map((exploration, index) => (
                        <li>
                            <a
                                href={exploration.path}
                                class:list={{ active: Astro.url.pathname === exploration.path }}
                            >
                                <span class="exploration-index"
                                    >{String(index + 1).padStart(2, "0")}</span
                                >
                                <span>{exploration.title}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
        <slot />
    </body>
</html>

<script>
    const trigger = document.querySelector<HTMLButtonElement>(".menu-trigger");
    const drawer = document.querySelector<HTMLElement>(".exploration-drawer");
    const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
    const closeButton = document.querySelector<HTMLButtonElement>(".drawer-close");

    if (trigger && drawer && backdrop && closeButton) {
        const setOpen = (open: boolean) => {
            trigger.setAttribute("aria-expanded", String(open));
            trigger.setAttribute(
                "aria-label",
                open ? "Close explorations menu" : "Open explorations menu",
            );
            drawer.setAttribute("aria-hidden", String(!open));
            document.body.classList.toggle("menu-open", open);

            if (open) closeButton.focus();
            else trigger.focus();
        };

        trigger.addEventListener("click", () => setOpen(true));
        closeButton.addEventListener("click", () => setOpen(false));
        backdrop.addEventListener("click", () => setOpen(false));

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
                setOpen(false);
            }
        });
    }
</script>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }

    :global(body) {
        --menu-ink: #171717;
        --menu-muted: #77736e;
        --menu-paper: #f6f5f1;
        --menu-line: rgba(23, 23, 23, 0.14);
    }

    .menu-trigger {
        position: fixed;
        z-index: 20;
        left: 1.5rem;
        bottom: 1.5rem;
        display: grid;
        width: 3.5rem;
        height: 3.5rem;
        place-content: center;
        gap: 0.28rem;
        border: 1px solid rgba(23, 23, 23, 0.16);
        border-radius: 999px;
        background: var(--menu-paper);
        color: var(--menu-ink);
        box-shadow: 0 0.75rem 2rem rgba(23, 23, 23, 0.14);
        cursor: pointer;
        transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
            background-color 180ms ease;
    }

    .menu-trigger:hover {
        transform: translateY(-0.15rem);
        background: white;
    }

    .menu-trigger:active,
    .drawer-close:active {
        transform: scale(0.96);
    }

    .menu-trigger span {
        display: block;
        width: 1.1rem;
        height: 1px;
        background: currentColor;
    }

    .menu-backdrop {
        position: fixed;
        z-index: 29;
        inset: 0;
        background: rgba(23, 23, 23, 0.2);
        opacity: 0;
        pointer-events: none;
        transition: opacity 220ms ease-out;
    }

    .exploration-drawer {
        position: fixed;
        z-index: 30;
        inset: 0 auto 0 0;
        width: min(24rem, calc(100vw - 2rem));
        padding: 2rem;
        box-sizing: border-box;
        background: var(--menu-paper);
        color: var(--menu-ink);
        box-shadow: 1rem 0 3rem rgba(23, 23, 23, 0.12);
        transform: translateX(-100%);
        transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
    }

    .menu-open .menu-backdrop {
        opacity: 1;
        pointer-events: auto;
    }

    .menu-open .exploration-drawer {
        transform: translateX(0);
    }

    .drawer-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--menu-line);
    }

    .drawer-eyebrow {
        margin: 0 0 0.5rem;
        color: var(--menu-muted);
        font-family: var(--font-jetbrains);
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .drawer-header h2 {
        margin: 0;
        font-size: 2rem;
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .drawer-close {
        position: relative;
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        border: 1px solid var(--menu-line);
        border-radius: 999px;
        background: transparent;
        color: var(--menu-ink);
        cursor: pointer;
        transition: transform 160ms ease-out, background-color 160ms ease;
    }

    .drawer-close:hover {
        background: white;
    }

    .drawer-close span {
        position: absolute;
        width: 1rem;
        height: 1px;
        background: currentColor;
    }

    .drawer-close span:first-child {
        transform: rotate(45deg);
    }

    .drawer-close span:last-child {
        transform: rotate(-45deg);
    }

    .exploration-drawer nav {
        padding-top: 1.25rem;
    }

    .exploration-drawer ul {
        display: grid;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .exploration-drawer a {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: 0.85rem 0;
        color: var(--menu-muted);
        font-size: 1.05rem;
        text-decoration: none;
        transition: color 160ms ease, padding-left 180ms ease-out;
    }

    .exploration-drawer a:hover,
    .exploration-drawer a.active {
        padding-left: 0.5rem;
        color: var(--menu-ink);
    }

    .exploration-index {
        min-width: 1.5rem;
        color: var(--menu-muted);
        font-family: var(--font-jetbrains);
        font-size: 0.65rem;
    }

    .menu-trigger:focus-visible,
    .drawer-close:focus-visible,
    .exploration-drawer a:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    @media (max-width: 640px) {
        .menu-trigger {
            left: 1rem;
            bottom: 1rem;
        }

        .exploration-drawer {
            padding: 1.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .menu-trigger,
        .menu-backdrop,
        .exploration-drawer,
        .drawer-close,
        .exploration-drawer a {
            transition: none;
        }
    }
</style>
